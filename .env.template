## Logging
LOGGING_LEVEL=INFO


## API
APP_NAME="Agentic RAG"
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8100,http://127.0.0.1:8100
APP_PORT=8100
FRONTEND_PORT=5173


## Auth Provider
## Supported values: supertokens (recommended), local, auth0, oidc, keycloak
AUTH_PROVIDER=supertokens


## Self-hosted SuperTokens
SUPERTOKENS_POSTGRES_DB=agentic_rag_auth
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME="Agentic RAG"
SUPERTOKENS_API_DOMAIN=http://localhost:8100
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:5173
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_BASE_PATH=/auth
SUPERTOKENS_COOKIE_DOMAIN=
SUPERTOKENS_COOKIE_SECURE=false
SUPERTOKENS_COOKIE_SAME_SITE=lax
FRONTEND_PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_TENANT_SIGNUP_ENABLED=true
INVITE_EXPIRY_HOURS=48
INVITATION_CONTEXT_SECRET=
INVITATION_CONTEXT_TTL_SECONDS=900
TEMPORARY_PASSWORD_PROVISIONING_ENABLED=true


## Email delivery
EMAIL_DELIVERY_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=noreply@agentic-rag.local
EMAIL_FROM_NAME="Agentic RAG"
SUPPORT_EMAIL=support@agentic-rag.local
EMAIL_WORKER_POLL_SECONDS=5
EMAIL_WORKER_MAX_ATTEMPTS=5
EMAIL_WORKER_LEASE_SECONDS=60
MAILPIT_UI_PORT=8025


## Local Auth
## Local auth is only for development and tests. Do not use it in production.
LOCAL_AUTH_TOKEN=local-dev-token
LOCAL_USER_ID=local-user
LOCAL_TENANT_ID=local-tenant
LOCAL_WORKSPACE_ID=
LOCAL_ROLES=admin,user
LOCAL_GROUPS=
LOCAL_SCOPES=documents:read,documents:write,documents:delete,query:run,ingestion:write
LOCAL_ACL_VERSION=1


## Auth0
## Required when AUTH_PROVIDER=auth0. AUTH0_DOMAIN is the tenant domain only,
## for example dev-example.us.auth0.com, without https:// or a trailing slash.
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
## Single Page Application client. Use Authorization Code with PKCE and no secret.
AUTH0_FRONTEND_CLIENT_ID=
AUTH0_FRONTEND_SCOPE=openid profile email
## Auth0 connection names shown as direct sign-in buttons in the frontend.
AUTH0_IDENTITY_CONNECTIONS=google-oauth2,github
## Connection IDs enabled when the bootstrap command creates an organization.
## Use Auth0 IDs such as con_xxx, not connection names.
AUTH0_ORGANIZATION_CONNECTION_IDS=
## Optional database connection ID used for invited email/password users.
AUTH0_DATABASE_CONNECTION_ID=
## Machine-to-machine client authorized for the Auth0 Management API.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_MANAGEMENT_TIMEOUT_SECONDS=10
AUTH0_INVITER_NAME="Agentic RAG"
AUTH0_INVITATION_TTL_SECONDS=604800


## PostgreSQL
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic_rag
POSTGRES_PASSWORD=agentic_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data/pgdata


## Database URLs
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ALEMBIC_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_agentic_rag.db


## SQLAlchemy
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


## Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_SOCKET_TIMEOUT_SECONDS=1
QUERY_CACHE_ENABLED=false
QUERY_CACHE_TTL_SECONDS=300
QUERY_CACHE_KEY_PREFIX=agentic-rag:query


## Kafka
KAFKA_PUBLISHING_ENABLED=false
KAFKA_CONSUMING_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=agentic-rag-worker
KAFKA_PORT=9092
KAFKA_PRODUCER_FLUSH_TIMEOUT_SECONDS=5
KAFKA_INGESTION_CONSUMER_GROUP=agentic-rag-ingestion
KAFKA_EMBEDDING_CONSUMER_GROUP=agentic-rag-embedding
KAFKA_INDEXING_CONSUMER_GROUP=agentic-rag-indexing
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1


## Kafka Topics
KAFKA_INGESTION_PARSE_TOPIC=ingestion.parse
KAFKA_INGESTION_METADATA_TOPIC=ingestion.metadata
KAFKA_INGESTION_CHUNK_TOPIC=ingestion.chunk
KAFKA_INGESTION_EMBED_TOPIC=ingestion.embed
KAFKA_INGESTION_INDEX_TOPIC=ingestion.index
KAFKA_RAG_LONG_QUERY_TOPIC=rag.long_query
KAFKA_EVAL_BATCH_TOPIC=eval.batch
KAFKA_RETRY_INGESTION_TOPIC=retry.ingestion
KAFKA_RETRY_EMBEDDING_TOPIC=retry.embedding
KAFKA_RETRY_INDEXING_TOPIC=retry.indexing
KAFKA_DLQ_INGESTION_TOPIC=dlq.ingestion
KAFKA_DLQ_EMBEDDING_TOPIC=dlq.embedding
KAFKA_DLQ_INDEXING_TOPIC=dlq.indexing
KAFKA_DLQ_RAG_TOPIC=dlq.rag


## Object Storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=agentic_rag
S3_SECRET_ACCESS_KEY=agentic_rag_password
S3_BUCKET_NAME=agentic-rag
S3_REGION=us-east-1
DOCUMENT_UPLOAD_MAX_BYTES=26214400


## Ingestion Worker
INGESTION_WORKER_POLL_SECONDS=5
INGESTION_WORKER_LEASE_SECONDS=300
INGESTION_RETRY_BASE_SECONDS=30
INGESTION_RETRY_MAX_SECONDS=900
INGESTION_CHUNK_SIZE=2000
INGESTION_CHUNK_OVERLAP=200


## OpenSearch
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_DISABLE_SECURITY_PLUGIN=true
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_DOCUMENT_INDEX=documents-v1
OPENSEARCH_CHUNK_INDEX=chunks-v1
OPENSEARCH_CHUNK_READ_ALIAS=chunks-read
OPENSEARCH_CHUNK_WRITE_ALIAS=chunks-write
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=10
OPENSEARCH_SEARCH_RETRY_ATTEMPTS=2
OPENSEARCH_SEARCH_RETRY_BACKOFF_SECONDS=0.25
OPENSEARCH_INDEX_SHARDS=1
OPENSEARCH_INDEX_REPLICAS=0
INDEXING_WORKER_POLL_SECONDS=5
BM25_INDEX_BATCH_SIZE=100
BM25_MIN_SCORE=0


## Embedding Worker
EMBEDDING_PROVIDER=litellm
EMBEDDING_MODEL_NAME=gemini/gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_VECTOR_VERSION=1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_INPUT_CHARS=128000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WORKER_POLL_SECONDS=5
EMBEDDING_WORKER_MAX_CHUNKS_PER_LOOP=100


## LLM Gateway
LLM_SYNTHESIS_ENABLED=true
LLM_PROVIDER=litellm
## Tenant provider records are stored in PostgreSQL. Keep the environment
## fallback enabled during local setup, then disable it after every tenant has
## explicit defaults. Generate one Fernet key and keep it in a secret manager.
LLM_PROVIDER_DATABASE_ENABLED=true
LLM_PROVIDER_ENV_FALLBACK_ENABLED=true
LLM_PROVIDER_ENCRYPTION_KEY=
LLM_API_KEY=
LITELLM_BASE_URL=
LITELLM_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
DEFAULT_SMALL_MODEL=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_MAX_INPUT_CHARS=64000
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_STATE_BACKEND=memory
LLM_CIRCUIT_BREAKER_REDIS_KEY_PREFIX=agentic-rag:llm:circuit-breaker
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
LLM_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=


## Local Model Runtime
OLLAMA_BASE_URL=http://localhost:11434
RERANKER_MODEL_NAME=BAAI/bge-reranker-base


## Agent Runtime Limits
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_STEP_TIMEOUT_SECONDS=20
AGENT_TOTAL_TIMEOUT_SECONDS=90
AGENT_MAX_SAME_TOOL_REPEAT=2


## Observability
OTEL_SERVICE_NAME=agentic-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PATH=/metrics
